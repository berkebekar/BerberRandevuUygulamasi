# Veritabanı
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Güvenlik
SECRET_KEY=CHANGE_ME_MIN_32_CHARS_SECRET_KEY_FOR_PROD
SUPER_ADMIN_SESSION_SECRET=CHANGE_ME_ANOTHER_32_CHARS_SECRET

# Ortam: development | production
ENV=development

# Redis (WhatsApp bot state yönetimi)
REDIS_URL=redis://localhost:6379/0

# WhatsApp Business API (Meta Cloud API)
# Meta Dashboard > App > WhatsApp > Configuration > Verify Token alanına girilecek değer
WA_VERIFY_TOKEN=benim_gizli_verify_token_123

# NOT: phone_number_id ve access_token tenant bazında DB'de saklanır.
# Superadmin panelinden veya direkt DB üzerinden her tenant için ayrı girilir:
#   UPDATE tenants
#   SET whatsapp_phone_number_id = '1112722798587499',
#       whatsapp_access_token    = 'EAAG...'
#   WHERE subdomain = 'berber-adi';

# Firebase Authentication Phone provider (SMS OTP)
FIREBASE_PROJECT_ID=
# Raw service account JSON or base64-encoded JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
