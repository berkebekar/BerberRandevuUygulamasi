# PostgreSQL bağlantı URL'i. asyncpg kullanıldığı için backend tarafında postgresql+asyncpg://... yazılır.
# Örnek: postgresql+asyncpg://postgres:postgres@db:5432/postgres
DATABASE_URL=

# JWT ve oturum imzası için en az 32 karakter rastgele string. Production'da mutlaka güçlü ve gizli tutulmalı.
SECRET_KEY=

# Twilio SMS hesabı (MVP'de OTP için kullanılacak)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Ana domain; örn: app.com. Subdomain'ler buraya göre çözümlenir.
APP_DOMAIN=

# Super admin panel hostu. Bos ise superadmin.{APP_DOMAIN} kullanilir.
SUPERADMIN_HOST=

# İzin verilen subdomain'ler; virgülle ayrılmış liste. Örn: berber1,berber2
ALLOWED_SUBDOMAINS=

# Super admin monitoring için frontend canlı sağlık kontrol URL'i.
# Örn: https://berber.bbsoft.com.tr
FRONTEND_HEALTHCHECK_URL=

# Super admin tenant oluşturunca Coolify frontend domain/SSL kaydını otomatik günceller.
# Coolify API base URL'i /api/v1 ile bitmeli. Örn: http://178.208.187.237:8000/api/v1
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_FRONTEND_APP_UUID=
COOLIFY_INSTANT_DEPLOY_ON_TENANT_CREATE=false

# Tenant domain strategy:
# - wildcard: tenant create sadece DB kaydi yapar; *.APP_DOMAIN routing/SSL proxy tarafinda cozulur.
# - coolify: tenant create Coolify frontend domain listesini gunceller.
TENANT_DOMAIN_STRATEGY=wildcard

# Ortam: development veya production
ENV=development

# Frontend host routing.
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_SUPERADMIN_HOST=
