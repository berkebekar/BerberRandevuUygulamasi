# PostgreSQL connection URL. Backend uses asyncpg, so use postgresql+asyncpg://...
# Example: postgresql+asyncpg://postgres:postgres@db:5432/postgres
DATABASE_URL=

# JWT/session signing secret. Use a strong secret with at least 32 characters in production.
SECRET_KEY=

# Twilio SMS account (for OTP if enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Main domain. Tenant subdomains resolve under this domain.
APP_DOMAIN=

# Superadmin panel host. Leave empty to use superadmin.{APP_DOMAIN}.
SUPERADMIN_HOST=

# Allowed subdomains, comma-separated. Example: berber1,berber2
ALLOWED_SUBDOMAINS=

# Frontend healthcheck target for superadmin monitoring.
# Example: https://berber.bbsoft.com.tr
FRONTEND_HEALTHCHECK_URL=

# WhatsApp Cloud API / Coexistence
# Platform token is shared; tenant phone number ids are stored in the database.
# Meta webhook callback: https://<api-domain>/api/v1/whatsapp/webhook
# For test numbers, use the Meta API Setup token/phone number id and bind the phone number id to a tenant in superadmin.
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_LONG_ABSENCE_TEMPLATE_NAME=long_time_no_visit_reminder
WA_LONG_ABSENCE_TEMPLATE_LANGUAGE=tr

# Firebase Authentication Phone provider (SMS OTP)
FIREBASE_PROJECT_ID=
# Raw service account JSON or base64-encoded JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Environment: development or production
ENV=development

# Frontend host routing.
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_SUPERADMIN_HOST=

# Firebase Web SDK (tenant auth page)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
